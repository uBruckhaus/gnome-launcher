#!/usr/bin/env bash
# Simple Launcher for Fools - Toggle script
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PID_FILE="/tmp/simple-launcher-for-fools.pid"

is_running() {
    local pid="$1"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

if [[ -f "$PID_FILE" ]]; then
    PID="$(cat "$PID_FILE" 2>/dev/null || true)"
    if is_running "$PID"; then
        kill -USR1 "$PID" 2>/dev/null || true
        exit 0
    else
        rm -f "$PID_FILE"
    fi
fi

# Fallback: check if process is running by name
PIDS="$(pgrep -f "${DIR}/launcher_popup.py" || true)"
if [[ -n "$PIDS" ]]; then
    for p in $PIDS; do
        kill -USR1 "$p" 2>/dev/null || true
    done
    exit 0
fi

# Start launcher popup in background
/usr/bin/python3 "${DIR}/launcher_popup.py" >/dev/null 2>&1 &
echo "$!" > "$PID_FILE"
