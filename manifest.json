{
  "schemaVersion": 1,
  "id": "ubruckhaus.simple-launcher-for-fools",
  "name": "Simple Launcher",
  "version": "1.4.0",
  "author": "Uwe Bruckhaus",
  "license": "MIT",
  "description": "Fast, theme-aware launcher for Omarchy apps, widgets, plugins and tray apps, with an advanced shortcut editor: bind keys or two-step sequences to apps, their actions or tray menu entries, see who owns every key and rebind any of them in one click.",
  "homepage": "https://github.com/ubruckhaus/omarchy-simple-launcher-for-fools",
  "repository": "https://github.com/ubruckhaus/omarchy-simple-launcher-for-fools",
  "keywords": [
    "launcher",
    "menu",
    "apps",
    "gtk4",
    "layer-shell",
    "shortcuts",
    "keybindings",
    "rebind",
    "omarchy",
    "widgets",
    "tray"
  ],
  "kinds": [
    "bar-widget"
  ],
  "keepLoaded": false,
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Simple Launcher",
    "description": "Toggle Simple Launcher",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left"
  }
}
